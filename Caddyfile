# Caddy: recebe o acesso de fora, cuida do HTTPS (certificado automático da
# Let's Encrypt) e repassa pra Nami. O domínio e o e-mail vêm do .env.
{
	email {$NAMI_EMAIL}
}

{$NAMI_DOMINIO} {
	encode zstd gzip

	# Envio de .cbz/.cbr no painel: mesmo limite da Nami (NAMI_UPLOAD_MAX_MB).
	# O resto do site só recebe formulários pequenos.
	@envio path /admin/obras /admin/obras/* /admin/ajustes/*
	request_body @envio {
		max_size 1GB
	}
	@resto not path /admin/obras /admin/obras/* /admin/ajustes/*
	request_body @resto {
		max_size 1MB
	}

	# Não conta pra quem acessa qual servidor está rodando.
	header -Server

	reverse_proxy nami:8000

	log {
		output stdout
		format console
	}
}
