# Copie para .env e ajuste. No PC (desenvolvimento) tudo é opcional.
# No Orange Pi, preencha a parte "Deploy" lá embaixo (ver docs/DEPLOY.md).

# Pasta do banco, da biblioteca local e do cache de capas (padrão: ./data).
# No Docker isso já vem definido (/data).
# NAMI_DATA_DIR=data

# Idiomas dos capítulos, em ordem de preferência.
# NAMI_IDIOMAS=["pt-br","en"]

# data-saver = imagens comprimidas (poupa a banda de upload da sua internet)
# data       = qualidade original
# NAMI_QUALIDADE_PADRAO=data-saver

# Cache de capas no disco do servidor: capa sem uso há N dias é apagada, e a
# pasta nunca passa do tamanho máximo (em MB).
# NAMI_CAPAS_DIAS_SEM_USO=5
# NAMI_CACHE_CAPAS_MB=200

# Tamanho máximo de cada .cbz/.cbr enviado no painel de admin (em MB).
# NAMI_UPLOAD_MAX_MB=1024

# Limite de requisições por IP, por minuto (0 = sem limite).
# NAMI_LIMITE_POR_MINUTO=120
# NAMI_LIMITE_IMAGENS_POR_MINUTO=900

# Contas. Feche o cadastro depois que todo mundo que você quer tiver conta.
# NAMI_CADASTRO_ABERTO=true
# NAMI_SESSAO_DIAS=30
# No Docker o cookie seguro já vem ligado. No PC (http://localhost) fica false.
# NAMI_COOKIE_SEGURO=false

# AniList: total de capítulos da obra original, onde ler oficialmente e busca
# de metadados no admin. false desliga (as páginas só ficam sem essa parte).
# NAMI_ANILIST_ATIVO=true

# ------------------------------------------------------------------- Deploy
# Como o site fica acessível: "caddy" (abre portas 80/443 no roteador) ou
# "tunel" (Cloudflare Tunnel, funciona com CGNAT). Ver docs/DEPLOY.md.
# COMPOSE_PROFILES=caddy

# Pro Caddy: seu domínio (ex.: nami-fulano.duckdns.org) e um e-mail pro aviso
# do certificado HTTPS.
# NAMI_DOMINIO=
# NAMI_EMAIL=

# Pro Cloudflare Tunnel: o token que o painel da Cloudflare mostra.
# CLOUDFLARE_TUNNEL_TOKEN=
